{
  "$schema": "https://static.cloudbase.net/cli/cloudbaserc.schema.json",
  "version": "2.1",
  "envId": "{{env.TCB_ENV_ID}}",
  "region": "ap-shanghai",
  "functionRoot": "./cloudfunctions",
  "functions": [
    {
      "name": "health",
      "type": "HTTP",
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "timeout": 10,
      "memorySize": 256,
      "description": "每日体坛速览 · 健康检查（GET /api/health）",
      "ignore": [
        "node_modules/**",
        ".git/**",
        "*.md"
      ]
    },
    {
      "name": "api",
      "type": "HTTP",
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "timeout": 15,
      "memorySize": 256,
      "description": "每日体坛速览 · 业务读接口（Day 17：GET /api/hot）",
      "envVariables": {
        "CB_ENV_ID": "{{env.TCB_ENV_ID}}",
        "CB_API_KEY": "{{env.CB_API_KEY}}"
      },
      "ignore": [
        "node_modules/**",
        ".git/**",
        "*.md"
      ]
    },
    {
      "name": "favorites",
      "type": "HTTP",
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "timeout": 15,
      "memorySize": 256,
      "description": "每日体坛速览 · 收藏接口（Day 18：POST + GET /api/favorites）",
      "envVariables": {
        "CB_ENV_ID": "{{env.TCB_ENV_ID}}",
        "CB_API_KEY": "{{env.CB_API_KEY}}"
      },
      "ignore": [
        "node_modules/**",
        ".git/**",
        "*.md"
      ]
    },
    {
      "name": "matches",
      "type": "HTTP",
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "timeout": 15,
      "memorySize": 256,
      "description": "每日体坛速览 · 赛程比分写接口（Day 22：GET + PATCH + DELETE /api/matches）",
      "envVariables": {
        "CB_ENV_ID": "{{env.TCB_ENV_ID}}",
        "CB_API_KEY": "{{env.CB_API_KEY}}"
      },
      "ignore": [
        "node_modules/**",
        ".git/**",
        "*.md"
      ]
    },
    {
      "name": "news",
      "type": "HTTP",
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "timeout": 15,
      "memorySize": 256,
      "description": "每日体坛速览 · 资讯写接口（Day 22：GET + PATCH + DELETE /api/news）",
      "envVariables": {
        "CB_ENV_ID": "{{env.TCB_ENV_ID}}",
        "CB_API_KEY": "{{env.CB_API_KEY}}"
      },
      "ignore": [
        "node_modules/**",
        ".git/**",
        "*.md"
      ]
    }
  ],
  "gateway": {
    "routes": [
      {
        "path": "/api/health",
        "target": "function:health",
        "enableAuth": false
      },
      {
        "path": "/api/hot",
        "target": "function:api",
        "enableAuth": false
      },
      {
        "path": "/api/favorites",
        "target": "function:favorites",
        "enableAuth": false
      },
      {
        "path": "/api/matches",
        "target": "function:matches",
        "enableAuth": false
      },
      {
        "path": "/api/news",
        "target": "function:news",
        "enableAuth": false
      }
    ]
  }
}
