# ===== 环境变量与密钥（本地专用，永远不上传 GitHub）=====
.env
.env.*
# 但模板要进仓库：没有它，接手的人不知道该填哪几个变量。
# （Day 23 实测：少了这行，.env.* 会把 .env.example 一起忽略掉，模板根本提交不进去。）
!.env.example

# ===== 依赖 =====
node_modules/

# ===== 系统文件 =====
.DS_Store
Thumbs.db

# ===== 编辑器 =====
.vscode/
.idea/

# ===== 本地调试预览（WorkBuddy 生成，不入库）=====
.workbuddy-preview/

# ===== CloudBase 部署临时产物（Day 15，不入库）=====
# .cloudbase-publish/ 是上传静态托管前的临时发布目录（脚本每次重建）
# .cloudbase-backup/ 是 tcb hosting deploy --safe 生成的发布前备份
# .cloudbase-build/ 是云函数部署前的组装目录（Day 20 起，含 shared/ 拷贝）
.cloudbase-publish/
.cloudbase-backup/
.cloudbase-build/

# ===== 每日本地临时工作区（Day 22 起，不入库）=====
# _dayNN_tmp/ 存放当日验证脚本与截图中间产物；正式截图归档到 docs/，此目录不入库
_day*_tmp/

# ===== 版本产物快照（Day 26 起，不入库）=====
# 静态托管没有版本管理，回退靠重部署产物快照（scripts_cloudbase/release.mjs 生成）。
# 快照是可重建的（git tag + build-publish.mjs 就能再生成一份），
# 且含 data/nba.json 这类 540KB 大文件 —— 进仓库只会把历史撑大，故不入库。
.releases/

