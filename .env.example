# ============================================================
# .env.example — 环境变量模板（Day 23 建）
# ------------------------------------------------------------
# 用法：
#   1) 复制一份改名：  cp .env.example .env     （Windows: copy .env.example .env）
#   2) 把 <...> 占位换成自己的真实值
#   3) .env 已被 .gitignore 忽略，**永远不要** git add 它
#
# 为什么这个文件要进仓库，而 .env 不能：
#   接手的人（或半年后的自己）需要知道「跑起来要填哪几个变量」，
#   但真实值一个都不能进仓库 —— 一进就等同于公开。
#   所以：模板进库、真值留本地。
#
# ⚠️ 不要往这个文件里填真实密钥，它是要提交的。
# ⚠️ .gitignore 里 .env.* 会连带忽略本文件，因此特意加了一条
#    `!.env.example` 把它放回来（Day 23 实测：少了这条，模板根本提交不进去）。
# ============================================================

# ---- 内容数据源 Key（Day 17 起改为直接抓三平台官网，这个变量目前未被代码使用） ----
NEWS_API_KEY=

# ---- 数据库直连串（本项目走 CloudBase PG 的 HTTP API，不用 TCP 直连；留空即可） ----
DATABASE_URL=

# ---- CloudBase 环境 ID（是「ID」不是环境名「ross」；cloudbaserc.json 的 envId 引用它） ----
TCB_ENV_ID=<环境 ID，形如 ross-xxxxxxxxxxxxxxxx>

# ---- CloudBase PG 的服务端 API Key（云函数访问 PostgREST 时鉴权用） ----
# 取值位置：CloudBase 控制台 → 数据库 → API Key。
# 本地跑 scripts_cloudbase/test-api-local.cjs --with-db 也读这个值。
# 它只进「云函数环境变量」和本机 .env，绝不能出现在代码、文档、仓库里。
# （形态：以「eyJ」开头的一长串，很长，别手抄漏字符）
CB_API_KEY=<粘贴完整 Key>
